{
  "name": "weave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc && esbuild web/app.ts --bundle --format=esm --outfile=web/app.js",
    "start": "node dist/src/server.js",
    "test": "node --test dist/tests/*.test.js",
    "capture": "node dist/host_capture/server.js",
    "acceptance": "node dist/scripts/acceptance.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.ts\" \"web/*.{ts,css,html}\" \"host_*/*.ts\""
  },
  "dependencies": {
    "ws": "8.22.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.5",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3"
  }
}
